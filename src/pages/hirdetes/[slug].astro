---
import AdSiteLayout from '../../layouts/AdSiteLayout.astro';
import AdSiteSection from '../../components/AdSiteSection.astro';
import { adSites } from '../../lib/adsites.js';

export function getStaticPaths() {
  return adSites.map((site) => ({ params: { slug: site.slug }, props: { site } }));
}
const { site } = Astro.props;
const main = site.sections.filter((s) => !s.aside);
const aside = site.sections.filter((s) => s.aside);
---
<AdSiteLayout site={site}>
  {main.map((s) => <AdSiteSection s={s} />)}
  {(aside.length > 0 || site.badges) && (
    <Fragment slot="aside">
      {aside.map((s) => <AdSiteSection s={s} />)}
      {site.badges?.map((b) => <p class="pg-adsite__badge">{b}</p>)}
    </Fragment>
  )}
</AdSiteLayout>
