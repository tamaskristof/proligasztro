---
/* One section of an invented advertiser's homepage (see src/lib/adsites.js for the kinds). */
const { s } = Astro.props;
---
<section id={s.id} class:list={['pg-adsite__section', s.small && 'is-small']}>
  <h2 class="pg-adsite__h">{s.title}</h2>
  {s.kind === 'text' && s.paras.map((p) => <p set:html={p} />)}
  {s.kind === 'list' && <ul class="pg-adsite__list">{s.items.map((i) => <li>{i}</li>)}</ul>}
  {s.kind === 'steps' && <ol class="pg-adsite__steps">{s.items.map((i) => <li>{i}</li>)}</ol>}
  {s.kind === 'table' && (
    <table class="pg-adsite__table">
      {s.head && <thead><tr>{s.head.map((h) => <th scope="col">{h}</th>)}</tr></thead>}
      <tbody>{s.rows.map((r) => <tr>{r.map((c) => <td>{c}</td>)}</tr>)}</tbody>
    </table>
  )}
  {s.kind === 'table' && s.note && <p class="pg-adsite__note">{s.note}</p>}
  {s.kind === 'quotes' && s.items.map((q) => (
    <blockquote class:list={['pg-adsite__quote', q.odon && 'is-odon']}>
      <p>„{q.text}”</p>
      <footer>– {q.who}</footer>
    </blockquote>
  ))}
  {s.kind === 'contact' && (
    <dl class="pg-adsite__contact">{s.rows.map(([k, v]) => <><dt>{k}:</dt><dd>{v}</dd></>)}</dl>
  )}
  {s.button && <p class="pg-adsite__buttonrow"><a class="pg-adsite__button" href={s.button.href}>{s.button.label}</a></p>}
</section>
